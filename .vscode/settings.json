{
    // see:
    // - <https://squidfunk.github.io/mkdocs-material/creating-your-site/#minimal-configuration-visual-studio-code>
    // - <https://github.com/redhat-developer/vscode-yaml/issues/238#issuecomment-2776729405>
    "yaml.schemas": {
        "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"
    },
    "yaml.customTags": [
        "!ENV scalar",
        "!ENV sequence",
        "!relative scalar",
        "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
        "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
        "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
        "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/target": true,
        "**/site": true,
        "**/htmlcov": true
    },
    "lldb.rpcServer": {
        "host": "localhost",
        "port": 9552,
        "token": "secret",
    },
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.cargo.features": [
        "pytaurix-core/__private",
        "pytaurix/standalone",
        "pytaurix/tauri-devtools",
        "pytaurix/tauri-macos-private-api",
        "pytaurix/plugin-notification",
        "pytaurix/plugin-dialog",
        "pytaurix/plugin-clipboard-manager",
        "pytaurix/plugin-fs",
        "pytaurix/plugin-opener",
        "pytaurix/plugin-autostart",
        "pytaurix/plugin-deep-link",
        "pytaurix/plugin-http",
        "pytaurix/plugin-os",
        "pytaurix/plugin-persisted-scope",
        "pytaurix/plugin-positioner",
        "pytaurix/plugin-process",
        "pytaurix/plugin-shell",
        "pytaurix/plugin-single-instance",
        "pytaurix/plugin-updater",
        "pytaurix/plugin-upload",
        "pytaurix/plugin-websocket",
        "pytaurix/plugin-window-state",
        "pytaurix/plugin-global-shortcut",
        "pytaurix/plugin-log",
        "pytaurix/plugin-store",
        "pytaurix/plugin-stronghold",
        "pytaurix/plugin-cli",
        "pyo3-utils/unstable",
    ],
}
