{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on the first day of the month"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["tauri", "tauri-build", "tauri-plugin", "pyo3"],
      "labels": ["dependencies", "manual-platform-validation"],
      "automerge": false
    }
  ]
}
