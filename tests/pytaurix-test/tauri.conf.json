{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pytaurix-test",
  "version": "0.1.0",
  "identifier": "com.pytaurix-test.app",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "main",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "../../examples/tauri-app-wheel/python/src/tauri_app_wheel/icons/icon.png",
      "../../examples/tauri-app-wheel/python/src/tauri_app_wheel/icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {},
    "updater": {
      "pubkey": "test-public-key-not-used-without-download",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
